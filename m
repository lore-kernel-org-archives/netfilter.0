*filter
:INPUT ACCEPT [434:49608]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [740:64416]
:HiMoNN-ACL-ath0 - [0:0]
-A INPUT -i ath0 -j HiMoNN-ACL-ath0 
-A FORWARD -i ath0 -j HiMoNN-ACL-ath0 
-A HiMoNN-ACL-ath0 -j DROP 

#!/bin/sh=0A=
#=0A=
# Startup script to implement /etc/sysconfig/iptables pre-defined rules.=0A=
#=0A=
# chkconfig: 2345 08 92=0A=
#=0A=
# description: Automates a packet filtering firewall with iptables.=0A=
#=0A=
# by bero@redhat.com, based on the ipchains script:=0A=
# Script Author:	Joshua Jensen <joshua@redhat.com>=0A=
#   -- hacked up by gafton with help from notting=0A=
# modified by Anton Altaparmakov <aia21@cam.ac.uk>:=0A=
# modified by Nils Philippsen <nils@redhat.de>=0A=
#=0A=
# config: /etc/sysconfig/iptables=0A=
=0A=
# Source 'em up=0A=
. /etc/init.d/functions=0A=
=0A=
IPTABLES_CONFIG=3D/etc/sysconfig/iptables=0A=
=0A=
if [ ! -x /sbin/iptables ]; then=0A=
	exit 0=0A=
fi=0A=
=0A=
KERNELMAJ=3D`uname -r | sed                   -e 's,\..*,,'`=0A=
KERNELMIN=3D`uname -r | sed -e 's,[^\.]*\.,,' -e 's,\..*,,'`=0A=
=0A=
if [ "$KERNELMAJ" -lt 2 ] ; then=0A=
	exit 0=0A=
fi=0A=
if [ "$KERNELMAJ" -eq 2 -a "$KERNELMIN" -lt 3 ] ; then=0A=
	exit 0=0A=
fi=0A=
=0A=
=0A=
=0A=
if  /sbin/lsmod 2>/dev/null |grep -q ipchains ; then=0A=
	# Don't do both=0A=
	exit 0=0A=
fi=0A=
=0A=
start() {=0A=
	# don't do squat if we don't have the config file=0A=
	if [ -f $IPTABLES_CONFIG ]; then=0A=
	    # If we don't clear these first, we might be adding to=0A=
	    #  pre-existing rules.=0A=
	    action $"Flushing all current rules and user defined chains:" =
iptables -F=0A=
	    action $"Clearing all current rules and user defined chains:" =
iptables -X=0A=
	    chains=3D`cat /proc/net/ip_tables_names 2>/dev/null`=0A=
            for i in $chains; do iptables -t $i -F; done && \=0A=
              success $"Flushing all current rules and user defined =
chains:" || \=0A=
              failure $"Flushing all current rules and user defined =
chains:"	    =0A=
            for i in $chains; do iptables -t $i -X; done && \=0A=
              success $"Clearing all current rules and user defined =
chains:" || \=0A=
              failure $"Clearing all current rules and user defined =
chains:"=0A=
=0A=
            for i in $chains; do iptables -t $i -Z; done=0A=
=0A=
	    echo $"Applying iptables firewall rules: "=0A=
		grep -v "^[[:space:]]*#" $IPTABLES_CONFIG | grep -v '^[[:space:]]*$' | =
/sbin/iptables-restore -c && \=0A=
		    success $"Applying iptables firewall rules" || \=0A=
		    failure $"Applying iptables firewall rules"=0A=
	    echo=0A=
	    touch /var/lock/subsys/iptables=0A=
	fi=0A=
	=0A=
	=0A=

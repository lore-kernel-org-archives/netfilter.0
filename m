	   iptables -P FORWARD ACCEPT && \=0A=
	   iptables -t nat -P PREROUTING ACCEPT && \=0A=
	   iptables -t nat -P POSTROUTING ACCEPT && \=0A=
	   iptables -t nat -P OUTPUT ACCEPT && \=0A=
           iptables -t mangle -P PREROUTING ACCEPT && \=0A=
           iptables -t mangle -P OUTPUT ACCEPT && \=0A=
	   success $"Resetting built-in chains to the default ACCEPT policy" || =
\=0A=
	   failure $"Resetting built-in chains to the default ACCEPT policy"=0A=
